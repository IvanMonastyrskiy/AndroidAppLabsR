<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AndroidAppRomanova.ViewModels"
             xmlns:views="using:AndroidAppRomanova.Views"
             x:Class="AndroidAppRomanova.Views.MainView"
             x:DataType="vm:MainViewModel">
    <TabControl>
        <TabItem Header="Калькулятор">
            <views:Calculator/>
        </TabItem>
        <TabItem Header="Пятнашки">
            <views:Game/>
        </TabItem>
        <TabItem Header="Матрица">
            <views:MatrixPage/>
        </TabItem>
    </TabControl>
</UserControl>