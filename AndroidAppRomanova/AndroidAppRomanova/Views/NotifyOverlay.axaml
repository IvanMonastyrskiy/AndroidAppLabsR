<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AndroidAppRomanova.ViewModels"
             x:Class="AndroidAppRomanova.Views.NotifyOverlay"
             x:DataType="vm:NotifyViewModelBase">
    <Grid IsVisible="{Binding IsNotificationVisible}" Background="#99000000">
        <Border Background="White"
                CornerRadius="16"
                Padding="24"
                Margin="24"
                MaxWidth="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BoxShadow="0 8 24 0 #55000000">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <Image Source="avares://AndroidAppRomanova/Assets/warning.jpg"
                       Width="96" Height="96" />
                <TextBlock Text="{Binding NotificationTitle}"
                           Foreground="#222"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding NotificationMessage}"
                           Foreground="#444"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button Content="Понятно"
                        Classes="accent"
                        Command="{Binding CloseNotificationCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
